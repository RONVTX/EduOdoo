<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_alumno_list" model="ir.ui.view">
            <field name="name">Alumnos - Lista</field>
            <field name="model">eduodoo.alumno</field>
            <field name="arch" type="xml">
                <list decoration-success="activo" decoration-muted="not activo">
                    <field name="nombre"/>
                    <field name="apellidos"/>
                    <field name="email"/>
                    <field name="telefono"/>
                    <field name="numero_matriculas"/>
                    <field name="porcentaje_asistencia" widget="progressbar"/>
                    <field name="total_facturas_pendientes" widget="float" decoration-danger="total_facturas_pendientes > 0"/>
                    <field name="activo"/>
                </list>
            </field>
        </record>
        <record id="view_alumno_form" model="ir.ui.view">
            <field name="name">Alumnos - Formulario</field>
            <field name="model">eduodoo.alumno</field>
            <field name="arch" type="xml">
                <form>
                    
                    <sheet>
                       
                        <group>
                            <group string="Información Personal">
                                <field name="nombre"/>
                                <field name="apellidos"/>
                                <field name="nombre_completo" readonly="1"/>
                            </group>
                            <group string="Contacto">
                                <field name="email"/>
                                <field name="telefono"/>
                            </group>
                        </group>
                        <group string="Información de Dirección">
                            <field name="direccion"/>
                            <field name="ciudad"/>
                            <field name="codigo_postal"/>
                        </group>
                        <group string="Estadísticas Académicas">
                            <field name="numero_matriculas" readonly="1"/>
                            <field name="porcentaje_asistencia" readonly="1" widget="progressbar"/>
                            <field name="total_facturas_pendientes" readonly="1"/>
                            <field name="fecha_registro" readonly="1"/>
                        </group>
                        <group string="Estado">
                            <field name="activo"/>
                        </group>
                        <notebook>
                            <page string="Cursos Inscritos">
                                <field name="cursos" widget="many2many_tags"/>
                            </page>
                            <page string="Matrículas">
                                <field name="matriculas" readonly="1"/>
                            </page>
                            <page string="Facturas">
                                <field name="facturas" readonly="1"/>
                            </page>
                            <page string="Asistencias">
                                <field name="asistencias_clases" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_alumno_search" model="ir.ui.view">
            <field name="name">Alumnos - Búsqueda</field>
            <field name="model">eduodoo.alumno</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nombre"/>
                    <field name="apellidos"/>
                    <field name="email"/>
                    <field name="telefono"/>
                    <filter name="filter_activos" string="Activos" domain="[('activo', '=', True)]"/>
                    <filter name="filter_inactivos" string="Inactivos" domain="[('activo', '=', False)]"/>
                </search>
            </field>
        </record>
        <record id="action_alumno" model="ir.actions.act_window">
            <field name="name">Alumnos</field>
            <field name="res_model">eduodoo.alumno</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_alumno_search"/>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_alumno_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_alumno_form')})]" />
        </record>
    </data>
</odoo>
