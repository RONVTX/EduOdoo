<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_profesor_tree" model="ir.ui.view">
            <field name="name">Profesores - Lista</field>
            <field name="model">eduodoo.profesor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="partner_id"/>
                </list>
            </field>
        </record>

        <record id="view_profesor_form" model="ir.ui.view">
            <field name="name">Profesores - Formulario</field>
            <field name="model">eduodoo.profesor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Información Personal">
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                            <group string="Información Adicional">
                                <field name="partner_id"/>
                            </group>
                        </group>
                        <group string="Notas">
                            <field name="notas" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Sesiones Asignadas">
                                <field name="sesiones"/>
                            </page>
                            <page string="Clases">
                                <field name="clases"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista búsqueda para Profesores -->
        <record id="view_profesor_search" model="ir.ui.view">
            <field name="name">Profesores - Búsqueda</field>
            <field name="model">eduodoo.profesor</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                </search>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_profesor" model="ir.actions.act_window">
            <field name="name">Profesores</field>
            <field name="res_model">eduodoo.profesor</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_profesor_search"/>
            <field name="view_id" ref="view_profesor_tree"/>
        </record>

    </data>
</odoo>
