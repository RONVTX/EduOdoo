<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sesion_list" model="ir.ui.view">
            <field name="name">Sesiones - Lista</field>
            <field name="model">eduodoo.sesion</field>
            <field name="arch" type="xml">
                <list decoration-danger="is_full" decoration-warning="porcentaje_ocupacion >= 35 and porcentaje_ocupacion &lt; 70" decoration-success="porcentaje_ocupacion &lt; 35">
                    <field name="numero_sesion"/>
                    <field name="curso_id"/>
                    <field name="clase_id"/>
                    <field name="profesor_id"/>
                    <field name="fecha_inicio"/>
                    <field name="estado"/>
                    <field name="asientos_ocupados"/>
                    <field name="numero_asientos"/>
                    <field name="occupancy_bar_html" widget="html" string="Porcentaje Ocupación"/>
                </list>
            </field>
        </record>

        <record id="view_sesion_form" model="ir.ui.view">
            <field name="name">Sesiones - Formulario</field>
            <field name="model">eduodoo.sesion</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_iniciar_sesion" type="object" string="Iniciar Sesión" class="oe_highlight" invisible="estado != 'programada'"/>
                        <button name="action_finalizar_sesion" type="object" string="Finalizar Sesión" class="oe_highlight" invisible="estado not in ['en_curso']"/>
                        <button name="action_cancelar_sesion" type="object" string="Cancelar Sesión" class="btn btn-danger" invisible="estado == 'cancelada'"/>
                        <button name="action_generar_reporte_sesion" type="object" string="Generar Reporte" class="btn btn-info" invisible="estado not in ['finalizada', 'en_curso']"/>
                        <field name="estado" widget="statusbar" statusbar_visible="programada,en_curso,finalizada,cancelada"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_generar_reporte_sesion" type="object" string="Reporte" icon="fa-bar-chart" class="oe_stat_button"/>
                        </div>
                        <group>
                            <group string="Información Principal">
                                <field name="numero_sesion"/>
                                <field name="curso_id"/>
                                <field name="clase_id"/>
                            </group>
                            <group string="Profesor y Horario">
                                <field name="profesor_id"/>
                                <field name="fecha_inicio"/>
                                <field name="fecha_fin" readonly="1"/>
                                <field name="duracion"/>
                            </group>
                        </group>
                        <group string="Información de Ocupación">
                            <group>
                                <field name="numero_asientos"/>
                                <field name="asientos_ocupados" readonly="1"/>
                                <field name="asientos_disponibles" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_full" readonly="1"/>
                            </group>
                        </group>
                        <group string="Barra de Ocupación" colspan="2">
                            <field name="occupancy_bar_html" widget="html" readonly="1" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Descripción">
                            <field name="descripcion" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sesion_kanban" model="ir.ui.view">
            <field name="name">Sesiones - Kanban</field>
            <field name="model">eduodoo.sesion</field>
            <field name="arch" type="xml">
                <kanban default_group_by="curso_id">
                    <field name="numero_sesion"/>
                    <field name="curso_id"/>
                    <field name="clase_id"/>
                    <field name="profesor_id"/>
                    <field name="porcentaje_ocupacion"/>
                    <field name="occupancy_color_hsl"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_record">
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_record_title">
                                        <field name="numero_sesion"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle">
                                        <span t-if="record.curso_id.raw_value">(</span>
                                        <field name="curso_id"/>
                                        <span t-if="record.curso_id.raw_value">)</span>
                                    </div>
                                    <div class="o_kanban_record_details">
                                        <field name="clase_id"/>
                                        <span> · </span>
                                        <field name="profesor_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_footer">
                                    <div class="progress" style="margin-bottom: 0; background-color: #f0f0f0; border-radius: 4px; overflow: hidden;">
                                        <div class="progress-bar" t-attf-style="width: #{record.porcentaje_ocupacion.raw_value or 0}%; background-color: #{record.occupancy_color_hsl.raw_value or 'hsl(120, 100%, 45%)'}; color: white; font-weight: bold; display: flex; align-items: center; justify-content: center;" role="progressbar" t-att-aria-valuenow="record.porcentaje_ocupacion.raw_value or 0" aria-valuemin="0" aria-valuemax="100">
                                            <t t-esc="record.porcentaje_ocupacion.raw_value or 0"/> %
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-name="card">
                            <t t-call="kanban-box"/>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_sesion_calendar" model="ir.ui.view">
            <field name="name">Sesiones - Calendario</field>
            <field name="model">eduodoo.sesion</field>
            <field name="arch" type="xml">
                <calendar string="Sesiones" date_start="fecha_inicio" date_stop="fecha_fin" color="color">
                    <field name="numero_sesion"/>
                    <field name="profesor_id"/>
                    <field name="curso_id"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                </calendar>
            </field>
        </record>

        <record id="view_sesion_search" model="ir.ui.view">
            <field name="name">Sesiones - Search</field>
            <field name="model">eduodoo.sesion</field>
            <field name="arch" type="xml">
                <search>
                    <field name="numero_sesion"/>
                    <field name="curso_id"/>
                    <field name="clase_id"/>
                    <field name="profesor_id"/>
                </search>
            </field>
        </record>

        <record id="action_sesion" model="ir.actions.act_window">
            <field name="name">Sesiones</field>
            <field name="res_model">eduodoo.sesion</field>
            <field name="view_mode">kanban,calendar,list,form</field>
            <field name="search_view_id" ref="view_sesion_search"/>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_sesion_kanban')}), (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_sesion_calendar')}), (0, 0, {'view_mode': 'list', 'view_id': ref('view_sesion_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_sesion_form')})]" />
        </record>
    </data>
</odoo>
