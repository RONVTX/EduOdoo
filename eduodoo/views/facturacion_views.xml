<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista lista de Facturación -->
        <record id="view_facturacion_list" model="ir.ui.view">
            <field name="name">Facturación - Lista</field>
            <field name="model">eduodoo.facturacion</field>
            <field name="arch" type="xml">
                <list decoration-success="estado == 'pagada'" decoration-warning="estado == 'parcialmente_pagada'" decoration-danger="factura_vencida and estado != 'pagada'">
                    <field name="numero_factura"/>
                    <field name="alumno_id"/>
                    <field name="curso_id"/>
                    <field name="concepto"/>
                    <field name="cantidad"/>
                    <field name="saldo_pendiente" widget="float"/>
                    <field name="fecha_factura"/>
                    <field name="fecha_vencimiento"/>
                    <field name="estado"/>
                    <field name="factura_vencida" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Vista formulario de Facturación -->
        <record id="view_facturacion_form" model="ir.ui.view">
            <field name="name">Facturación - Formulario</field>
            <field name="model">eduodoo.facturacion</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_marcar_pagada" type="object" string="Marcar como Pagada" class="oe_highlight" invisible="estado == 'pagada'"/>
                        <button name="action_cancelar_factura" type="object" string="Cancelar Factura" class="btn btn-danger" invisible="estado == 'cancelada'"/>
                        <field name="estado" widget="statusbar" statusbar_visible="pendiente,parcialmente_pagada,pagada,cancelada"/>
                    </header>
                    <sheet>
                        <div class="alert alert-danger" role="alert" invisible="not factura_vencida">
                            <strong>¡FACTURA VENCIDA!</strong> La factura venció el <field name="fecha_vencimiento" class="font-weight-bold"/>
                        </div>
                        <group>
                            <group string="Información de Factura">
                                <field name="numero_factura" readonly="1"/>
                                <field name="alumno_id" readonly="estado != 'pendiente'"/>
                                <field name="curso_id" readonly="estado != 'pendiente'"/>
                            </group>
                            <group string="Fechas">
                                <field name="fecha_factura"/>
                                <field name="fecha_vencimiento" readonly="1"/>
                                <field name="fecha_pago" readonly="1"/>
                            </group>
                        </group>
                        <group string="Concepto y Monto">
                            <group>
                                <field name="concepto"/>
                                <field name="cantidad"/>
                                <field name="dias_vencimiento"/>
                            </group>
                            <group>
                                <field name="cantidad_pagada" readonly="1"/>
                                <field name="saldo_pendiente" readonly="1"/>
                            </group>
                        </group>
                        <group string="Información Adicional">
                            <field name="descripcion"/>
                            <field name="notas"/>
                            <field name="activo"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_facturacion_search" model="ir.ui.view">
            <field name="name">Facturación - Búsqueda</field>
            <field name="model">eduodoo.facturacion</field>
            <field name="arch" type="xml">
                <search>
                    <field name="numero_factura"/>
                    <field name="alumno_id"/>
                    <field name="curso_id"/>
                    <filter name="filter_pendientes" string="Pendientes" domain="[('estado', '=', 'pendiente')]"/>
                    <filter name="filter_parcialmente" string="Parcialmente Pagadas" domain="[('estado', '=', 'parcialmente_pagada')]"/>
                    <filter name="filter_pagadas" string="Pagadas" domain="[('estado', '=', 'pagada')]"/>
                    <filter name="filter_canceladas" string="Canceladas" domain="[('estado', '=', 'cancelada')]"/>
                    <filter name="filter_por_cobrar" string="Por Cobrar (Pendiente + Parcial)" domain="[('estado', 'in', ['pendiente', 'parcialmente_pagada'])]"/>
                    <filter name="filter_matricula" string="Matrículas" domain="[('concepto', '=', 'matricula')]"/>
                    <filter name="filter_mensualidad" string="Mensualidades" domain="[('concepto', '=', 'mensualidad')]"/>
                </search>
            </field>
        </record>

        <record id="action_facturacion" model="ir.actions.act_window">
            <field name="name">Facturación</field>
            <field name="res_model">eduodoo.facturacion</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_facturacion_search"/>
            <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_facturacion_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_facturacion_form')})]" />
        </record>
    </data>
</odoo>
